{
  "id": "example.sdk-youtube-copy",
  "version": "0.2.37",
  "intent": "Copy a selected YouTube video link in one gesture. Optionally request captions for local TAP capture; publication stays a separate user action.",
  "license": "MIT",
  "page": "page.js",
  "files": [
    "LICENSE",
    "handler.py",
    "vendor/PROVENANCE.md"
  ],
  "entrypoints": {
    "handler": {
      "file": "handler.py",
      "interface": "python-jsonl-v1"
    }
  },
  "config": {
    "request-timeout-ms": {
      "type": "integer",
      "default": 60000
    }
  },
  "access": {
    "origins": [
      "*"
    ],
    "capabilities": [
      "bridge.handle",
      "page.inject"
    ]
  }
}
